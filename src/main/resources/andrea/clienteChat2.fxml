<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600" prefWidth="400" spacing="10"
    xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="andrea.cliente.ClienteChat">


    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="inputAlias" prefWidth="250" promptText="Ingresa tu alias" />
        <Button fx:id="btnConectar" onAction="#conectar" text="Conectar" />
    </HBox>


    <TextArea fx:id="chatArea" editable="false" prefHeight="300" wrapText="true" />


    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="inputMensaje" prefWidth="250" promptText="Escribe tu mensaje aquí" />
        <Button fx:id="btnEnviar" onAction="#enviarMensaje" text="Enviar" />
    </HBox>


    <VBox alignment="CENTER" spacing="5">
        <Label text="Usuarios conectados:" />
        <ListView fx:id="listaUsuarios" prefHeight="150" />
    </VBox>


    <Button fx:id="btnDesconectar" onAction="#desconectar" text="Desconectar" />

</VBox>