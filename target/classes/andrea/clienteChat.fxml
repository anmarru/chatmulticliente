<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="andrea.cliente.ClienteChat"
      spacing="10" alignment="CENTER" prefWidth="400" prefHeight="300">

    <!-- Área de chat -->
    <TextArea fx:id="chatArea" editable="false" prefHeight="200" wrapText="true"/>

    <!-- Contenedor para el campo de texto y el botón de envío -->
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="messageField" promptText="Escribe tu mensaje aquí..." HBox.hgrow="ALWAYS"/>
        <Button text="Enviar" onAction="#enviarMensaje"/>
    </HBox>
</VBox>
